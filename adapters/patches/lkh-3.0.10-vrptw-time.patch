+static void Read_TRAVEL_TIME_SECTION(void)
+{
+    int i, j;
+    if (ProblemType != CVRPTW || Dim < 1 || TravelTimeMatrix)
+        eprintf("TRAVEL_TIME_SECTION requires CVRPTW, DIMENSION and a single table");
+    if ((size_t) Dim > SIZE_MAX / sizeof(int) / (size_t) Dim)
+        eprintf("TRAVEL_TIME_SECTION: table too large");
+    TravelTimeMatrix = malloc((size_t) Dim * Dim * sizeof(int));
+    if (!TravelTimeMatrix)
+        eprintf("TRAVEL_TIME_SECTION: allocation failed");
+    for (i = 0; i < Dim; ++i) {
+        char *p = ReadLine(ProblemFile), *end;
+        if (!p)
+            eprintf("TRAVEL_TIME_SECTION: missing row %d", i + 1);
+        for (j = 0; j < Dim; ++j) {
+            long value;
+            errno = 0;
+            value = strtol(p, &end, 10);
+            if (end == p || errno == ERANGE || value < 0 || value > INT_MAX ||
+                (*end && !isspace((unsigned char) *end)) || (i == j && value))
+                eprintf("TRAVEL_TIME_SECTION: invalid entry (%d,%d)", i + 1, j + 1);
+            TravelTimeMatrix[(size_t) i * Dim + j] = (int) value;
+            p = end;
+        }
+        while (isspace((unsigned char) *p))
+            ++p;
+        if (*p)
+            eprintf("TRAVEL_TIME_SECTION: extra entry in row %d", i + 1);
+    }
+}
+
+static void CheckTravelTimeBounds(int MaxArc)
+{
+    long double window = 0, service = 0, demand = fabsl((long double) Capacity);
+    long double clock, penalty;
+    int i;
+    for (i = 1; i <= Dim; ++i) {
+        Node *N = &NodeSet[i];
+        if (!isfinite(N->Earliest) || !isfinite(N->Latest) ||
+            !isfinite(N->ServiceTime) || N->ServiceTime < 0)
+            eprintf("TRAVEL_TIME_SECTION: invalid window or service at node %d", i);
+        window = fmaxl(window, fmaxl(fabsl(N->Earliest), fabsl(N->Latest)));
+        service += N->ServiceTime;
+        demand += fabsl((long double) N->Demand);
+    }
+    /* A route has at most Dim physical legs. The existing penalty updates
+       mix GainType and double. Bound their exact integer range (also int64). */
+    clock = window + service + (long double) Dim * MaxArc;
+    penalty = ((long double) Dim - 1 + Salesmen) * (clock + window) +
+        (Dim - 1) * demand + (long double) Salesmen *
+        (Dim + fabsl((long double) MTSPMinSize) + fabsl((long double) MTSPMaxSize));
+    if (penalty > 9007199254740991.0L)
+        eprintf("TRAVEL_TIME_SECTION: clock or penalty exceeds exact integer range");
+}
