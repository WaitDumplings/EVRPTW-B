+static int TravelTime(Node *a, Node *b)
+{
+    Node *lo = a->Id <= DimensionSaved ? a : b;
+    Node *hi = lo == a ? b : a;
+    int i, j;
+    /* Only the structural i <-> i+h pair has zero time here. A required
+       physical arc from FIXED_EDGES_SECTION still uses its directed time. */
+    if (hi->Id - lo->Id == DimensionSaved)
+        return 0;
+    if (lo->Id > DimensionSaved || hi->Id <= DimensionSaved ||
+        (Salesmen > 1 && Forbidden(a, b)))
+        return M;
+    if (lo->DepotId && hi->DepotId)
+        return 0;
+    if (Salesmen > 1 && hi->DepotId && hi->DepotId <= ExternalSalesmen &&
+        lo->Id <= Dim)
+        return 0;
+    /* The physical arc is low i -> high j+h in either traversal direction.
+       Depot copies in either half represent the original depot. */
+    i = lo->DepotId ? Depot->Id : lo->Id;
+    j = hi->DepotId ? Depot->Id : hi->Id - DimensionSaved;
+    if (i < 1 || i > Dim || j < 1 || j > Dim)
+        eprintf("TravelTime: mapped arc (%d,%d) outside 1..%d "
+                "(a: Id=%d DepotId=%d, b: Id=%d DepotId=%d)",
+                i, j, Dim, a->Id, a->DepotId, b->Id, b->DepotId);
+    return TravelTimeMatrix[(size_t) (i - 1) * Dim + j - 1];
+}
 
